#. type: Plain text
#: src/man/authselect.8.adoc:135
msgid ""
"You can refer to RETURN CODES section for specific error codes returned by "
"the command."
msgstr ""

#. type: Labeled list
#: src/man/authselect.8.adoc:136
#, no-wrap
msgid "*test* profile_id [options] [features]"
msgstr ""

